includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
        - database
        # Test support models (not the Pest test files) are analysed so that the
        # public Messageable trait is exercised by a concrete consumer.
        - tests/Models
        - tests/Database
    # The package ships its own config directory; tell Larastan so that env()
    # calls there are not flagged as "outside the config directory".
    configDirectories:
        - config
    # Register the package view namespace so Larastan can resolve `messenger::*`
    # view strings exactly as the service provider does at runtime.
    bootstrapFiles:
        - tests/phpstan/register-views.php
    tmpDir: build/phpstan
